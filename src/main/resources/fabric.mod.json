{
	"schemaVersion": 1,
	"id": "xenaddons",
	"version": "${version}",
	"name": "XenAddons",
	"description": "XenusAddons is a Fabric mod for Minecraft 26.1.2, mostly designed to get features forgotten in 1.8.9",
	"authors": [
		"Xenus"
	],
  	"contact": {
		"homepage": "https://modrinth.com/mod/xenaddons",
		"issues": "https://discord.gg/yRbJJwGTPG",
		"discord" : "https://discord.gg/yRbJJwGTPG"
	},
	"license": "All Rights Reserved",
	"icon": "assets/xenaddons/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xenus.xenaddons.XenAddons"
		],
		"preLaunch": [
			"xenus.xenaddons.XenAddonsPreLaunch"
		],
		"client": [
			"xenus.xenaddons.XenAddonsClient"
		]
	},
	"mixins": [
		"xenaddons.mixins.json",
		{
			"config": "xenaddons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"custom": {
		"modmenu": {
			"update_checker": true,
			"links": {
				"modmenu.discord": "https://discord.gg/yRbJJwGTPG"
				}
		}
	}
}
