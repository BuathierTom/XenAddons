{
	"schemaVersion": 1,
	"id": "xenaddons",
	"version": "${version}",
	"name": "XenAddons",
	"description": "XenusAddons is a Fabric mod for Minecraft 1.21.10, mostly designed to get features forgotten in 1.8.9",
	"authors": [
		"Xenus"
	],
	"license": "All Rights Reserved",
	"icon": "assets/xenaddons/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xenus.xenaddons.XenAddons"
		],
		"client": [
			"xenus.xenaddons.XenAddonsClient"
		]
	},
	"mixins": [
		"xenaddons.mixins.json",
		{
			"config": "xenaddons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"update_checker": true
		}
	}
}
