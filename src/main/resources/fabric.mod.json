{
	"schemaVersion": 1,
	"id": "xenaddons",
	"version": "${version}",
	"name": "XenAddons",
	"description": "XenusAddons is a Fabric mod for Minecraft 1.21.10, mostly designed to reduce the number of mods you use.",
	"authors": [
		"Xenus"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/xenaddons/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "xenus.xenaddons.XenAddons",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "xenus.xenaddons.XenAddonsClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"xenaddons.mixins.json",
		{
			"config": "xenaddons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}