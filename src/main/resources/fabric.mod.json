{
	"schemaVersion": 1,
	"id": "xenaddons",
	"version": "${version}",
	"name": "XenAddons",
	"description": "XenusAddons is a Fabric mod for Minecraft 1.21.10, mostly designed to get somes features forgoten in 1.8.9",
	"authors": [
		"Xenus"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/xenaddons/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xenus.xenaddons.XenAddons"
		],
		"client": [
			"xenus.xenaddons.XenAddonsClient"
		]
	},
	"mixins": [
		"xenaddons.mixins.json",
		{
			"config": "xenaddons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	}
}